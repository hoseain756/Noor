<?xml version="1.0" encoding="utf-8"?>
<!-- Night-mode launch splash: matches the app's dark canvas so the
     edge-to-edge launch never flashes white before Flutter's first frame.
     The day variant (drawable/launch_background.xml) keeps the existing
     white splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />

